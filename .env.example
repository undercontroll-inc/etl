ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_SITE_ID=MLB
ML_API_BASE_URL=https://api.mercadolibre.com

DB_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://undercontroll:undercontroll@localhost:5432/undercontroll
SQLITE_PATH=./data/etl.db

ETL_TARGET_CATEGORIES=MLB5726
ETL_SNAPSHOT_BUCKET=month
ETL_MAX_WORKERS=4
ETL_ENRICH_BATCH_SIZE=20
ETL_REQUEST_TIMEOUT=30
ETL_MAX_RETRIES=5
ETL_OFFERS_MAX_PAGES=3
ETL_LOG_LEVEL=INFO

ETL_QUALITY_MIN_CATEGORY_COVERAGE=0.5
ETL_QUALITY_MIN_CURATED=1
ETL_QUALITY_WARN_CURATED=5
ETL_QUALITY_MIN_PRICE_COVERAGE=0.5

SCORE_WEIGHTS=rank:0.35,trajectory:0.25,trends:0.15,relevance:0.15,persistence:0.10
SCORE_PRIORITY_THRESHOLD=75

ETL_SCHEDULE_CRON=0 3 1 * *

ETL_AUTO_PUBLISH=true
